{
  "rules": {
    ".read": false,
    ".write": false,
    "keys": {
      ".read": false,
      ".write": false
    },
    "stats": {
      ".read": "auth != null",
      "devices": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "days": {
        "$day": {
          ".write": "auth != null",
          ".validate": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "scores": {
      ".read": "auth != null",
      ".indexOn": ["best"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'best', 't']) && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() >= 3000)",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
        "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "public": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (root.child('rooms').child($code).child('host').val() === auth.uid || (!newData.exists() && !root.child('rooms').child($code).exists()))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['mode', 'name', 'n', 'state', 'created'])",
        "mode": { ".validate": "newData.val() === 'race' || newData.val() === 'drag' || newData.val() === 'city' || newData.val() === 'stunt'" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
        "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
        "state": { ".validate": "newData.val() === 'lobby' || newData.val() === 'running'" },
        "created": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && root.child('keys').child(newData.child('key').val()).val() === true) || (data.exists() && !newData.exists() && (data.child('host').val() === auth.uid || data.child('created').val() < now - 10800000)))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['host', 'key', 'created', 'mode', 'state', 'round'])",
        "host": { ".validate": "newData.isString() && newData.val().length < 64" },
        "key": { ".validate": "newData.isString() && newData.val().length < 64" },
        "created": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "mode": { ".validate": "newData.val() === 'race' || newData.val() === 'drag' || newData.val() === 'city' || newData.val() === 'stunt'" },
        "state": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'running'"
        },
        "start": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000"
        },
        "round": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
        },
        "players": {
          "$slot": {
            ".write": "auth != null && $slot.matches(/^[0-5]$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || (!newData.exists() && root.child('rooms').child($code).child('host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'kind', 'color', 'ps']) && (root.child('rooms').child($code).exists() || newData.parent().parent().child('host').val() === auth.uid)",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "kind": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "special": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "ps": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "$other": { ".validate": false }
          }
        },
        "live": {
          "$slot": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child($slot).child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['t', 'r']) && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() >= 40)",
            "t": { ".validate": "newData.isNumber()" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "x": { ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000" },
            "z": { ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000" },
            "y": { ".validate": "newData.isNumber() && newData.val() > -100 && newData.val() < 1000" },
            "a": { ".validate": "newData.isNumber() && newData.val() >= -4 && newData.val() <= 4" },
            "b": { ".validate": "newData.isNumber() && newData.val() >= -4 && newData.val() <= 4" },
            "h": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
            "v": { ".validate": "newData.isNumber() && newData.val() > -100 && newData.val() < 300" },
            "p": { ".validate": "newData.isNumber() && newData.val() > -1000 && newData.val() < 100000" },
            "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
            "fin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 3600" },
            "$other": { ".validate": false }
          }
        },
        "tag": {
          ".write": "auth != null && newData.exists() && root.child('rooms').child($code).child('players').child('' + newData.child('by').val()).child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['it', 'by', 't']) && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() >= 500)",
          "it": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 5" },
          "by": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "chat": {
          "$slot": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child($slot).child('uid').val() === auth.uid",
            ".validate": "newData.hasChild('t') && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() >= 1000) && newData.hasChild('m') !== newData.hasChild('x')",
            "m": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 64 && newData.val() % 1 === 0" },
            "x": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80 && !root.child('public').child($code).exists()" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
